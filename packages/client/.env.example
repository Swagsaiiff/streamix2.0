# STREAMIX 2.0 Client Configuration

# Optional CORS Proxy URL (e.g., Cloudflare Worker or Express proxy)
# When set, all scraper queries to third-party movie endpoints (e.g., VegaMovies)
# are routed through this proxy to avoid browser-side CORS blocks.
# Example: VITE_CORS_PROXY=https://streamix-cors-proxy.your-subdomain.workers.dev/?url=
VITE_CORS_PROXY=

# Optional Stremio Stream Addon endpoint (e.g. Torrentio, MediaFusion, or self-hosted Stremio stream addon)
# Example: VITE_STREMIO_STREAM_ADDON=https://your-stremio-addon.com
VITE_STREMIO_STREAM_ADDON=
